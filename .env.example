# CitizenDB runs fully in local demo mode and needs NO environment variables.
# These placeholders are only for an optional future hosted (Supabase/PostgreSQL) mode,
# which is NOT implemented yet. Never put a service-role/admin key in browser code.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-public-anon-key
